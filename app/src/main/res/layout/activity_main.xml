
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INVENTARIO GAS"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:padding="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL DEL CHOFER"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp"/>

        <Button
            android:id="@+id/btnCargar"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="CARGAR LLENOS"/>

        <Button
            android:id="@+id/btnDescargar"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="15dp"
            android:text="DESCARGAR VACÍOS"/>

        <Button
            android:id="@+id/btnVentas"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="15dp"
            android:text="REGISTRAR VENTAS"/>

        <Button
            android:id="@+id/btnInventario"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="15dp"
            android:text="MI INVENTARIO"/>

    </LinearLayout>
</ScrollView>
