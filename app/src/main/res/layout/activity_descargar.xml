
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCARGAR CILINDROS VACÍOS"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:padding="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingrese los cilindros que deja en el local:"
            android:textSize="17sp"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/vacio5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vacíos de 5 kg"
            android:inputType="number"/>

        <EditText
            android:id="@+id/vacio11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vacíos de 11 kg"
            android:inputType="number"/>

        <EditText
            android:id="@+id/vacio15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vacíos de 15 kg"
            android:inputType="number"/>

        <EditText
            android:id="@+id/vacio45"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vacíos de 45 kg"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnGuardarDescarga"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:text="GUARDAR DESCARGA"/>

    </LinearLayout>
</ScrollView>
